{
  "name": "banco-alimentos-bob",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts && node --test db/migraciones/*.test.cjs",
    "test:integration": "node --env-file=.env.local --import tsx --test tests/integration/*.test.ts",
    "admin:init": "tsx scripts/inicializar-admin.ts",
    "archivos:limpiar": "tsx scripts/limpiar-archivos.ts"
  },
  "dependencies": {
    "argon2": "0.45.2",
    "mongodb": "7.9.1",
    "next": "16.4.6",
    "pdf-lib": "1.17.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.3",
    "@types/react": "19.3.1",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
